# Copy this file to .env and edit values as needed.
APP_NAME=LunaSafe AI Backend
APP_VERSION=0.1.0
# Comma-separated list of allowed frontend origins (Vite dev server default is 5173)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5182,http://127.0.0.1:5182
# Upload limits (must match frontend/src/constants/upload.js)
MAX_FILE_SIZE_MB=50
MAX_IMAGE_WIDTH=8192
MAX_IMAGE_HEIGHT=8192
# Where uploaded files are stored temporarily
UPLOAD_DIR=./uploads
# Hazard model defaults (see docs/ARCHITECTURE.md). These are CONFIG, not verified values.
LANDER_FOOTPRINT_DIAMETER_M=10.0
HAZARD_BOULDER_HEIGHT_M=0.5
SLOPE_GATE_DEG=10.0
